# =============================================================================
# Library Management API — environment variables
# Copy this file to .env and fill in the values. .env is gitignored.
# =============================================================================

# --- Database (required — app verifies the connection on startup) -----------
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@[SUPABASE_PROJECT].supabase.co:5432/postgres

# --- Supabase Storage (required — a storage client is built at startup) ------
STORAGE_URL=https://[SUPABASE_PROJECT].storage.supabase.co
STORAGE_ACCOUNT_SECRET=your-supabase-service-or-storage-key
STORAGE_BUCKET_NAME=books


# =============================================================================
# LLM (chat / conversation / RAG answering)
# Pick ONE provider block below. You can switch between them anytime by editing
# only these variables — no code changes needed.
# =============================================================================

# ---- FREE option A — OpenRouter free models (recommended, no install) -------
# Get a free key at https://openrouter.ai/keys ; pick any model ending in :free
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_API_KEY=sk-or-v1-your-openrouter-key-here
# Other free OpenRouter models you can try:
#   deepseek/deepseek-chat-v3-0324:free
#   google/gemini-2.0-flash-exp:free
#   qwen/qwen-2.5-72b-instruct:free

# ---- FREE option B — Groq (very fast, free tier) ----------------------------
# Get a free key at https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your-groq-key-here

# ---- FREE option C — Google Gemini (free tier; free embeddings too) ---------
# Get a free key at https://aistudio.google.com/apikey
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-google-ai-studio-key

# ---- FREE option D — Ollama (100% local, no key, needs install) -------------
# Install https://ollama.com , then: `ollama pull llama3.1`
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_API_KEY=                       # not needed for Ollama

# ---- PAID option — OpenAI -----------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-openai-key

# ---- PAID option — Anthropic / Claude -----------------------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-latest
# LLM_API_KEY=sk-ant-your-key

# Shared LLM tuning (apply to all providers)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=60


# --- Conversation context (optional — defaults are fine) ---------------------
CONTEXT_WINDOW_SIZE=20
SUMMARIZATION_THRESHOLD=15
SUMMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free   # cheap/free model for summaries


# =============================================================================
# RAG embeddings (ONLY needed to test /rag/query end-to-end)
# The pgvector column in sql/rag_setup.sql is vector(1536). Use a 1536-dim
# model OR change both EMBEDDING_DIMENSIONS and the SQL column to match.
# =============================================================================

# ---- Embeddings via OpenAI / OpenRouter (1536 dims — matches the SQL) -------
EMBEDDING_PROVIDER=openrouter            # openai | openrouter | ollama | google
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=                       # optional — falls back to LLM_API_KEY
EMBEDDING_DIMENSIONS=1536

# ---- FREE local embeddings via Ollama (768 dims — change SQL to vector(768)) -
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# OLLAMA_BASE_URL=http://localhost:11434

# ---- FREE embeddings via Google (768 dims — change SQL to vector(768)) ------
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=models/text-embedding-004
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_API_KEY=your-google-ai-studio-key

# --- RAG chunking / retrieval (optional — defaults are fine) -----------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3

# --- Vector store (optional — derived from STORAGE_* if unset) ---------------
VECTOR_TABLE_NAME=book_chunks
VECTOR_QUERY_FUNCTION=match_book_chunks


# --- Guardrails (optional — safe defaults; guards ON by default) -------------
GUARDRAILS_ENABLED=true
GUARDRAILS_DEBUG=false                   # set true locally to see why a request was blocked
GUARDRAILS_MIN_SUMMARY_LENGTH=20
GUARDRAILS_BLOCK_MUTATING_TOOLS_ON_INJECTION=true
